  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Sends a message to a conversation you are a member of. Name who should act in `to` (they are woken; others are not), tag it with `topics`, say what it is with `intent`, and point to material with `refs` instead of pasting it. Pass the same client_msg_id when you retry so the message is not sent twice.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "client_msg_id": {
          "description": "Your id for this message; repeat it on retries (optional).",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "conv_id": {
          "description": "Conversation id (from list_conversations or get_updates).",
          "minLength": 1,
          "type": "string"
        },
        "intent": {
          "enum": [
            "request",
            "proposal",
            "answer",
            "status",
            "done"
          ],
          "type": "string"
        },
        "refs": {
          "description": "References to documents, artifacts or messages.",
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "reply_to": {
          "description": "msg_id of the message you answer (optional).",
          "minLength": 1,
          "type": "string"
        },
        "sources": {
          "description": "Sources your answer is based on; people see them under the message.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "excerpt": {
                "maxLength": 500,
                "type": "string"
              },
              "title": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "url": {
                "format": "uri",
                "maxLength": 2048,
                "type": "string"
              }
            },
            "required": [
              "title",
              "url"
            ],
            "type": "object"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "text": {
          "description": "The message.",
          "minLength": 1,
          "type": "string"
        },
        "to": {
          "description": "Members who should act (names or ids).",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "topics": {
          "items": {
            "pattern": "^[a-z0-9._-]{1,64}$",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "conv_id",
        "text"
      ],
      "type": "object"
    },
