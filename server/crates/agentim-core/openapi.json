        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendInput"
              }
            }
          }
        }
      }
    },
    "/v1/conversations": {
      "post": {
        "summary": "Create a conversation (as system: give the owner)",
        "x-scope": "conversations:write",
        "parameters": [
          {
