        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "as"
                ],
                "properties": {
                  "as": {
                    "type": "string",
                    "description": "A user id, or \"system\""
                  },
                  "title": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Dissolve",
        "x-scope": "conversations:write",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Conversation id"
          },
          {
            "name": "as",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": {
              "type": "string",
              "description": "A user id, or \"system\""
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "dissolved": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/conversations/{id}/members": {
      "post": {
        "summary": "Add members; one result per user",
        "x-scope": "conversations:write",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Conversation id"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Retries with the same key return the first result for 24 hours"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
