{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentIM open API",
    "version": "1",
    "description": "Server API for a developer's backend (docs/07-open-api.md). Errors are RFC 9457 problem details with the same codes as the WebSocket protocol."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "An API key: ak_<key_id>_<secret>"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Same codes as the WebSocket protocol: bad_request, unauthorized, forbidden, missing_scope, not_found, conflict, blocked, policy_blocked, rate_limited, idempotency_mismatch, idempotency_in_progress, overloaded, storage_unavailable"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "human",
              "agent"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "avatar": {
            "type": [
              "string",
              "null"
            ]
          },
          "fields": {
            "type": [
              "object",
              "null"
            ]
          },
          "deactivated": {
            "type": "boolean"
          },
          "created_at": {
            "type": "integer"
          }
        }
      },
      "UserInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "human",
              "agent"
            ]
          },
          "owner": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          },
          "fields": {
            "type": "object"
          }
        }
      },
      "Device": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "platform": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "integer"
          },
          "expires_at": {
            "type": [
              "integer",
              "null"
            ]
          },
          "last_seen": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "Conversation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "dm",
              "group"
            ]
          },
          "title": {
            "type": "string"
          },
          "fields": {
            "type": [
              "object",
              "null"
            ]
          },
          "last_seq": {
            "type": "integer"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "user": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                }
              }
            }
          },
          "existing": {
            "type": "boolean"
          }
        }
      },
      "SendInput": {
        "type": "object",
        "required": [
          "as",
          "text"
        ],
        "properties": {
          "as": {
            "type": "string",
            "description": "A user id, or \"system\""
          },
          "text": {
            "type": "string",
            "description": "1..64 KiB; the fallback text for custom kinds"
          },
          "kind": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "client_msg_id": {
            "type": "string"
          },
          "reply_to": {
            "type": "string"
          },
          "to_user": {
            "type": "string"
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Members this asks to act (names or ids, 1..20); agents named here are woken"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "1..10 topics (a-z 0-9 . _ -)"
          },
          "intent": {
            "type": "string",
            "enum": [
              "request",
              "proposal",
              "answer",
              "status",
              "done"
            ]
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "1..20 references of up to 256 bytes"
          },
          "sources": {
            "type": "array",
            "description": "1..20 sources the message is based on",
            "items": {
              "type": "object",
              "required": [
                "title",
                "url"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "excerpt": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "SendResult": {
        "type": "object",
        "properties": {
          "conv_id": {
            "type": "string"
          },
          "seq": {
            "type": "integer"
          },
          "msg_id": {
            "type": "string"
          },
          "duplicate": {
            "type": "boolean"
          },
          "draft_id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "side_seq": {
            "type": "integer"
          }
        }
      },
      "ItemResult": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "Event": {
        "type": "object",
        "description": "A main-log event (docs/02-architecture.md §2.1)",
        "additionalProperties": true
      }
    }
  },
  "paths": {
    "/v1/users/{id}/tokens": {
      "post": {
        "summary": "Issue a client login token (a new device)",
        "x-scope": "tokens:issue",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Developer user id"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Retries with the same key return the first result for 24 hours"
          }
        ],
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "device": {
                      "$ref": "#/components/schemas/Device"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "device_name": {
                    "type": "string"
                  },
                  "platform": {
                    "type": "string"
                  },
                  "ttl_seconds": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Revoke all of a user's tokens and disconnect them",
        "x-scope": "tokens:issue",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Developer user id"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "revoked": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/users/{id}": {
      "put": {
        "summary": "Create or update a user (idempotent)",
        "x-scope": "users:write",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Developer user id"
