                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "as",
                  "kind",
                  "title"
                ],
                "properties": {
                  "as": {
                    "type": "string",
                    "description": "A user id, or \"system\""
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "dm",
                      "group"
                    ]
                  },
                  "title": {
                    "type": "string"
                  },
                  "members": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "owner": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/conversations/{id}": {
      "get": {
        "summary": "Read a conversation and its members",
