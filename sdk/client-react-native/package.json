{
  "name": "@agentimhq/client-react-native",
  "version": "0.1.0",
  "description": "AgentIM client SDK for React Native: the native core through JSI (docs/12 \u00a72.12), same API as @agentimhq/client-web",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmkrfjnwvb-svg/agentim.git",
    "directory": "sdk/client-react-native"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "cpp",
    "include",
    "android/CMakeLists.txt",
    "android/jniLibs",
    "ios",
    "AgentIMReactNative.podspec",
    "react-native.config.cjs"
  ],
  "peerDependencies": {
    "@agentimhq/client-web": "0.1.x",
    "react-native": ">=0.76"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --no-warnings --test test/*.test.mjs"
  },
  "devDependencies": {
    "@agentimhq/client-web": "file:../client-web",
    "typescript": "5.9.3"
  },
  "react-native": "src/react-native.ts",
  "codegenConfig": {
    "name": "AgentIMSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.agentim.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "AgentIM": "AgentIMModuleProvider"
      }
    }
  }
}
