{
  "name": "@agentim/client-web",
  "version": "0.1.0",
  "description": "AgentIM client SDK for browsers and Node: the Rust core (wasm) with WebSocket, an encrypted IndexedDB cache and one connection per account across tabs (docs/12 §2)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agentim_core.wasm": "./dist/agentim_core.wasm"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:wasm": "sh scripts/build-wasm.sh",
    "build": "tsc -p tsconfig.json && sh scripts/build-wasm.sh",
    "test": "npm run build && node --no-warnings --test test/*.test.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3"
  }
}
