{
  "name": "@agentim/client",
  "version": "0.1.0",
  "description": "AgentIM client SDK for browsers, React Native and Node: ordered sync, retries without duplicates, streaming AI messages, approvals",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --no-warnings --test test/*.test.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.6",
    "typescript": "5.9.3"
  }
}
