{
  "name": "@agentimhq/react",
  "version": "0.1.0",
  "description": "React hooks and components for AgentIM (docs/12 §3), on @agentimhq/client-web",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmkrfjnwvb-svg/agentim.git",
    "directory": "sdk/react"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/headless.d.ts",
      "default": "./dist/headless.js"
    },
    "./theme.css": "./theme.css",
    "./tokens.json": "./tokens.json"
  },
  "files": [
    "dist",
    "theme.css",
    "tokens.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "@agentimhq/client-web": "0.1.x",
    "react": "^18.2.0 || ^19.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node scripts/tokens.mjs --check && npm run build && vitest run",
    "e2e": "npm run build && node example/build.mjs && node test/e2e.mjs",
    "tokens": "node scripts/tokens.mjs"
  },
  "devDependencies": {
    "@agentimhq/client-web": "file:../client-web",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
