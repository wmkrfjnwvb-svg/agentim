---
// The frame of the marketing pages (home, cloud, pricing, benchmarks) in
// English or Chinese: header, footer, metadata. No analytics, no cookies,
// no third-party scripts; the font (Inter) is served from this site.
import '@fontsource-variable/inter';
import '../../styles/site.css';
import logoLight from '../../assets/logo-light.svg?raw';
import { copy, path, GITHUB, APP, type Lang } from '../../i18n/site';
interface Props { lang: Lang; title?: string; description?: string; page: string }
const { lang, title, description, page } = Astro.props;
const c = copy[lang];
const other = c.nav.otherLang;
const alt = (l: Lang) => `https://agentim.co${path(l, page)}`;
---
<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? c.meta.title}</title>
    <meta name="description" content={description ?? c.meta.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={alt(lang)} />
    <link rel="alternate" hreflang="en" href={alt('en')} />
    <link rel="alternate" hreflang="zh-CN" href={alt('zh')} />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={title ?? c.meta.title} />
    <meta property="og:description" content={description ?? c.meta.description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'zh' ? '跳到正文' : 'Skip to content'}</a>
    <header class="top">
      <div class="top-inner">
        <a href={path(lang, '/')} class="brand" aria-label="AgentIM" set:html={logoLight} />
        <input type="checkbox" id="menu" class="menu-toggle" aria-label="Menu" />
        <label for="menu" class="menu-button" aria-hidden="true"><span></span><span></span><span></span></label>
        <nav aria-label="Main">
          <a href={path(lang, '/#product')}>{c.nav.product}</a>
          <a href={path(lang, '/cloud/')} aria-current={page === '/cloud/' ? 'page' : undefined}>{c.nav.cloud}</a>
          <a href={path(lang, '/pricing/')} aria-current={page === '/pricing/' ? 'page' : undefined}>{c.nav.pricing}</a>
          <a href={path(lang, '/benchmarks/')} aria-current={page === '/benchmarks/' ? 'page' : undefined}>{c.nav.benchmarks}</a>
          <a href={path(lang, '/docs/')}>{c.nav.docs}</a>
          <a href={GITHUB} class="gh" aria-label="GitHub"><svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></a>
          <a href={path(other, page)} class="lang" hreflang={other === 'zh' ? 'zh-CN' : 'en'} lang={other === 'zh' ? 'zh-CN' : 'en'}>{c.nav.other}</a>
          <a href={APP} class="signin">{c.nav.signIn}</a>
          <a href={APP} class="button primary small">{c.nav.start}</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot">
      <div class="wrap foot-grid">
        <div class="foot-brand">
          <span set:html={logoLight} />
          <p>{c.footer.tagline}</p>
          <p class="muted small">{c.footer.privacy}</p>
        </div>
        {c.footer.cols.map((col) => (
          <div>
            <h3>{col.t}</h3>
            <ul>{col.l.map(([label, href]) => <li><a href={href.startsWith('/docs/') ? path(lang, href) : href}>{label}</a></li>)}</ul>
          </div>
        ))}
      </div>
      <div class="wrap foot-bottom">
        <span>© 2026 AgentIM · Apache-2.0</span>
        <a href={GITHUB}>GitHub</a>
      </div>
    </footer>
    <script>
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
        b.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(b.dataset.copy!);
            const t = b.textContent;
            b.textContent = b.dataset.done || 'Copied';
            setTimeout(() => (b.textContent = t), 1500);
          } catch {}
        }),
      );
    </script>
  </body>
</html>
