---
// /pricing (private docs/16 §3, D183): unlimited monthly users, plans by
// peak connections and messages; self-hosting is free. Billing is in early
// access: the Free plan is open, paid plans are sold as Stripe is turned on.
import Layout from './Layout.astro';
import { APP, path, type Lang } from '../../i18n/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
const t = (en: string, z: string) => (zh ? z : en);
const plans = [
  { name: 'Free', price: '$0', per: '', sub: t('No credit card', '无需绑卡'), cta: t('Start free', '免费开始'), href: APP, featured: false,
    points: [t('Unlimited monthly users', '不限月活用户'), t('200 peak connections', '200 个并发连接（峰值）'), t('1M messages a month', '每月 100 万条消息'), t('1M agent messages a month', '每月 100 万条 Agent 消息'), t('90 days of history, 2 GB of files', '消息保留 90 天，文件 2 GB'), t('2 projects, 2 team members', '2 个项目，2 名成员')] },
  { name: 'Pro', price: '$49', per: t('/month', '/月'), sub: t('$39/month billed yearly', '年付每月 $39'), cta: t('Start with Free', '先从免费版开始'), href: APP, featured: true,
    points: [t('Unlimited monthly users', '不限月活用户'), t('1,000 peak connections', '1,000 个并发连接（峰值）'), t('20M messages a month', '每月 2,000 万条消息'), t('10M agent messages a month', '每月 1,000 万条 Agent 消息'), t('1 year of history, 100 GB of files', '消息保留 1 年，文件 100 GB'), t('3 projects, 5 members, email support', '3 个项目，5 名成员，邮件支持')] },
  { name: 'Scale', price: '$249', per: t('/month', '/月'), sub: t('$199/month billed yearly', '年付每月 $199'), cta: t('Start with Free', '先从免费版开始'), href: APP, featured: false,
    points: [t('Unlimited monthly users', '不限月活用户'), t('5,000 peak connections', '5,000 个并发连接（峰值）'), t('100M messages a month', '每月 1 亿条消息'), t('100M agent messages a month', '每月 1 亿条 Agent 消息'), t('Unlimited history, 1 TB of files', '消息不限保留期，文件 1 TB'), t('10 projects, unlimited members, SSO, DPA', '10 个项目，不限成员，SSO，数据处理协议')] },
  { name: 'Enterprise', price: t('Custom', '定制'), per: '', sub: t('Dedicated instance, SLA', '专属实例，SLA'), cta: t('Contact us', '联系我们'), href: 'mailto:support@agentim.co', featured: false,
    points: [t('Custom connections and volume', '定制连接数和消息量'), t('99.99% SLA', '99.99% SLA'), t('Dedicated instance and region', '专属实例和区域'), t('HIPAA on request', '可提供 HIPAA'), t('Priority support', '优先支持')] },
];
const faq = [
  [t('Why not price by monthly active users?', '为什么不按月活用户收费？'), t('Customer-service and community apps have many users who visit once or twice a month. Pricing by peak connections and messages follows what your app really uses, and a marketing campaign does not double your bill.', '客服和社区类应用里，很多用户一个月只来一两次。按并发连接峰值和消息量计费，更贴近你的应用实际用量，一次营销活动也不会让账单翻倍。')],
  [t('What happens when I go over my plan?', '超出套餐会怎样？'), t('Your users are never cut off. You are warned at 80%; after going over you get 7 days of grace, then new connections wait and requests are slowed until you upgrade, turn on pay-as-you-go, or the month ends. Acknowledged messages and open connections are never affected.', '不会切断你的用户。用到 80% 时提醒；第一次超出后有 7 天宽限期，之后新连接需要排队、请求降速，直到你升级、打开按量付费或进入下个月。已确认的消息和已建立的连接都不受影响。')],
  [t('Is self-hosting really free?', '自己部署真的免费吗？'), t('Yes. The server is open source under Apache-2.0, with every feature. You pay only for your own servers.', '是的。服务端以 Apache-2.0 开源，包含全部功能，你只需支付自己服务器的费用。')],
  [t('Can I move between Cloud and my own servers?', '能在云服务和自己的服务器之间迁移吗？'), t('Yes, both ways. Cloud runs the same open-source server; export a project and import it into your own deployment, or the reverse.', '可以，双向都行。云服务运行的就是同一套开源服务端；导出项目再导入你自己的部署即可，反过来也一样。')],
  [t('Where is my data?', '数据存放在哪里？'), t('AgentIM Cloud runs in the EU (Paris). Each project has its own database. More regions will follow.', 'AgentIM 云服务运行在欧盟（巴黎），每个项目有自己独立的数据库。之后会开放更多区域。')],
];
---
<Layout lang={lang} page="/pricing/" title={t('Pricing — AgentIM', '价格 — AgentIM')}>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">{t('Pricing', '价格')}</p>
      <h1>{t('Unlimited users. Pay for what runs.', '不限用户数，按实际用量付费')}</h1>
      <p class="lead">{t('Plans by peak connections and messages, never by monthly active users. Self-hosting is free forever.', '按并发连接峰值和消息量分档，从不按月活用户收费。自己部署永远免费。')}</p>
      <p class="muted small" style="margin-top:14px">{t('Early access: the Free plan is open today; paid plans open as billing goes live.', '早期开放：免费版现已开放，付费版将在计费功能上线后开放。')}</p>
    </div>
  </section>
  <section style="padding-top:0">
    <div class="wrap">
      <div class="plans">
        {plans.map((p) => (
          <div class={p.featured ? 'plan featured' : 'plan'}>
            {p.featured && <span class="badge">{t('Most popular', '最受欢迎')}</span>}
            <h2>{p.name}</h2>
            <div class="price">{p.price}<small>{p.per}</small></div>
            <div class="sub">{p.sub}</div>
            <ul class="checks">{p.points.map((x) => <li>{x}</li>)}</ul>
            <a href={p.href} class={p.featured ? 'button primary' : 'button'}>{p.cta}</a>
          </div>
        ))}
      </div>
      <p class="muted small" style="margin-top:18px">{t('Over the plan with pay-as-you-go on (Pro and Scale, monthly): $10 per 1,000 extra peak connections, $1 per extra million messages. A spending cap is on by default.', '超出套餐且打开按量付费时（Pro 和 Scale 月付）：每多 1,000 个峰值连接 $10，每多 100 万条消息 $1。花费上限默认开启。')}</p>
    </div>
  </section>
  <section class="band">
    <div class="wrap two">
      <div class="option">
        <h3>{t('Self-hosted', '自己部署')}</h3>
        <div class="price" style="font:650 32px var(--mono);margin:10px 0">$0</div>
        <p>{t('Every feature, open source, on your servers. From one machine to a cluster.', '全部功能，开源，运行在你的服务器上。从单机到集群。')}</p>
        <div class="actions"><a class="button" href={path(lang, '/docs/operations/install/')}>{t('Install guide', '安装指南')} →</a></div>
      </div>
      <div class="option">
        <h3>{t('Questions about plans?', '对套餐有疑问？')}</h3>
        <p>{t('Tell us about your app and expected traffic. We reply within one business day.', '告诉我们你的应用和预计流量，我们会在一个工作日内回复。')}</p>
        <div class="actions"><a class="button" href="mailto:support@agentim.co">support@agentim.co</a></div>
      </div>
    </div>
  </section>
  <section>
    <div class="wrap">
      <h2>{t('Questions', '常见问题')}</h2>
      <div class="faq">{faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
      <p class="more"><a href={path(lang, '/cloud/')}>{t('About AgentIM Cloud', '了解 AgentIM 云服务')} →</a></p>
    </div>
  </section>
</Layout>
