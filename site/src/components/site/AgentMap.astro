---
// The AI platform as a picture: the model you bring on the left, AgentIM in
// the middle (role, Skills, knowledge, approvals), and your business systems
// on the right, reached through OpenAPI, MCP, app sign-in or webhooks. Pure
// SVG, no script; narrow screens get the same content as stacked logo rows.
// Then three steps that show how little it takes.
import type { Lang } from '../../i18n/site';
import { BRAND } from './brand-icons';

interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
const t = (en: string, z: string) => (zh ? z : en);

// Line icons on a 24 grid, drawn with a stroke.
const LINE: Record<string, string> = {
  role: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0',
  skills: 'M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9zM19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8z',
  knowledge: 'M5 4.5A1.5 1.5 0 0 1 6.5 3H20v15H6.5A1.5 1.5 0 0 0 5 19.5zM5 19.5A1.5 1.5 0 0 0 6.5 21H20M9 7h7M9 10.5h5',
  approval: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM8.5 12l2.5 2.5 4.5-5',
  server: 'M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01',
  database: 'M12 3c4.4 0 8 1.3 8 3s-3.6 3-8 3-8-1.3-8-3 3.6-3 8-3zM4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3',
  code: 'M8 6l-6 6 6 6M16 6l6 6-6 6',
  braces: 'M8 3H7a2 2 0 0 0-2 2v4a2 2 0 0 1-2 2 2 2 0 0 1 2 2v4a2 2 0 0 0 2 2h1M16 3h1a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2 2 2 0 0 0-2 2v4a2 2 0 0 1-2 2h-1',
  phone: 'M7.5 2h9a1.5 1.5 0 0 1 1.5 1.5v17a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 6 20.5v-17A1.5 1.5 0 0 1 7.5 2zM11 18.5h2',
  laptop: 'M5 5h14a1 1 0 0 1 1 1v9H4V6a1 1 0 0 1 1-1zM2 19h20',
  globe: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM3 12h18M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9',
};
type Mark = { brand?: string; line?: string; text?: string };

const W = 1160;
const H = 580;
const hub = { x: 470, y: 150, w: 220, h: 250 };
const hubL = { x: hub.x, y: hub.y + hub.h / 2 };
const hubR = { x: hub.x + hub.w, y: hub.y + hub.h / 2 };

const models: { name: string; mark: Mark }[] = [
  { name: 'Claude', mark: { brand: 'claude' } },
  { name: 'OpenAI', mark: { brand: 'openai' } },
  { name: 'Gemini', mark: { brand: 'googlegemini' } },
  { name: 'DeepSeek', mark: { text: 'DS' } },
  { name: 'Qwen', mark: { brand: 'alibabacloud' } },
  { name: t('Any API', '任意 API'), mark: { line: 'braces' } },
];
const arc = [250, 205, 180, 180, 205, 250];
const modelNodes = models.map((m, i) => ({ ...m, cx: arc[i], cy: 92 + i * 80, r: 28 }));

const inner = [
  { k: 'role', t: t('Role', '角色') },
  { k: 'skills', t: 'Skills' },
  { k: 'knowledge', t: t('Knowledge', '知识库') },
  { k: 'approval', t: t('Approvals', '审批') },
].map((x, i) => ({ ...x, x: hub.x + 18 + (i % 2) * 96, y: hub.y + 84 + Math.floor(i / 2) * 80, w: 88, h: 70 }));

const groups: { proto: string; soon?: boolean; items: { name: string; mark: Mark }[] }[] = [
  { proto: 'OpenAPI', items: [{ name: 'Shopify', mark: { brand: 'shopify' } }, { name: 'SAP', mark: { brand: 'sap' } }, { name: 'HubSpot', mark: { brand: 'hubspot' } }] },
  { proto: 'MCP', items: [{ name: 'Stripe', mark: { brand: 'stripe' } }, { name: 'GitHub', mark: { brand: 'github' } }, { name: 'Linear', mark: { brand: 'linear' } }] },
  { proto: t('Connect', '连接应用'), soon: true, items: [{ name: 'Slack', mark: { brand: 'slack' } }, { name: 'Gmail', mark: { brand: 'gmail' } }, { name: 'Salesforce', mark: { brand: 'salesforce' } }] },
  { proto: 'Webhook', items: [{ name: t('Services', '服务'), mark: { line: 'server' } }, { name: t('Database', '数据库'), mark: { line: 'database' } }, { name: t('Your code', '代码'), mark: { line: 'code' } }] },
];
const groupNodes = groups.map((g, i) => {
  const cy = 100 + i * 118;
  return {
    ...g, cy,
    pill: { x: 770, y: cy - 16, w: 108, h: 32 },
    box: { x: 910, y: cy - 46, w: 230, h: 92 },
    logos: g.items.map((it, j) => ({ ...it, cx: 952 + j * 74, cy: cy - 10, r: 22 })),
  };
});

const people = { x: hub.x + 10, y: 470, w: hub.w - 20, h: 64 };

const curve = (x1: number, y1: number, x2: number, y2: number) => {
  const mx = (x1 + x2) / 2;
  return `M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}`;
};
const paths = [
  ...modelNodes.map((m) => curve(m.cx + m.r, m.cy, hubL.x, hubL.y)),
  ...groupNodes.map((g) => curve(hubR.x, hubR.y, g.pill.x, g.cy)),
  ...groupNodes.map((g) => `M${g.pill.x + g.pill.w},${g.cy} L${g.box.x},${g.cy}`),
  `M${hub.x + hub.w / 2},${hub.y + hub.h} L${hub.x + hub.w / 2},${people.y}`,
];

const steps = [
  { n: '1', t: t('Connect a system', '接上系统'), d: t('Paste an OpenAPI document or an MCP server address in the console.', '在控制台粘贴 OpenAPI 文档或 MCP 服务地址。'), code: 'https://shop.example.com/openapi.json' },
  { n: '2', t: t('Add it to a role', '写进角色'), d: t('List the connection in a role and pick its Skills.', '在角色里列出这个连接，选好 Skills。'), code: 'apis: [orders]   mcp: [ups]' },
  { n: '3', t: t('It works in chat', '聊天里直接用'), d: t('The agent looks up orders, sends cards and asks before it changes anything.', 'Agent 查订单、发卡片，改数据前先等人批准。'), code: '' },
];
---

<figure class="amap" aria-labelledby="amap-cap">
  <svg class="amap-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="amap-cap">
    <defs>
      <radialGradient id="amap-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#2563eb" stop-opacity="0.16" />
        <stop offset="100%" stop-color="#2563eb" stop-opacity="0" />
      </radialGradient>
    </defs>

    <g class="amap-cols">
      <text x={180} y={34} text-anchor="middle">{t('Your AI model', '你的 AI 模型')}</text>
      <text x={hub.x + hub.w / 2} y={34} text-anchor="middle">AgentIM</text>
      <text x={824} y={34} text-anchor="middle">{t('Connect', '连接方式')}</text>
      <text x={1025} y={34} text-anchor="middle">{t('Your business', '企业业务')}</text>
    </g>

    <circle cx={hub.x + hub.w / 2} cy={hubL.y} r={220} fill="url(#amap-glow)" />

    <g class="amap-lines">{paths.map((d) => <path d={d} />)}</g>
    <g class="amap-flow" aria-hidden="true">{paths.map((d, i) => <path d={d} style={`animation-delay:${-(i * 0.41).toFixed(2)}s`} />)}</g>

    {modelNodes.map((m) => (
      <g class="amap-logo model">
        <title>{m.name}</title>
        <circle cx={m.cx} cy={m.cy} r={m.r} />
        {m.mark.brand && <svg x={m.cx - 13} y={m.cy - 13} width={26} height={26} viewBox="0 0 24 24"><path class="brand" d={BRAND[m.mark.brand]} /></svg>}
        {m.mark.line && <svg x={m.cx - 12} y={m.cy - 12} width={24} height={24} viewBox="0 0 24 24"><path class="line" d={LINE[m.mark.line]} /></svg>}
        {m.mark.text && <text class="mono" x={m.cx} y={m.cy + 6} text-anchor="middle">{m.mark.text}</text>}
        <text class="name" x={m.cx - m.r - 12} y={m.cy + 5} text-anchor="end">{m.name}</text>
      </g>
    ))}

    <g class="amap-hub">
      <rect class="hub-bg" x={hub.x} y={hub.y} width={hub.w} height={hub.h} rx={24} />
      <rect class="hub-mark" x={hub.x + 18} y={hub.y + 20} width={40} height={40} rx={11} />
      <path class="hub-glyph" d={`M${hub.x + 28},${hub.y + 31} h20 a3,3 0 0 1 3,3 v8 a3,3 0 0 1 -3,3 h-11 l-6,5 v-5 h-3 a3,3 0 0 1 -3,-3 v-8 a3,3 0 0 1 3,-3 z`} />
      <text class="hub-t" x={hub.x + 70} y={hub.y + 47}>AgentIM</text>
      {inner.map((x) => (
        <g class="hub-cell">
          <rect x={x.x} y={x.y} width={x.w} height={x.h} rx={12} />
          <svg x={x.x + x.w / 2 - 12} y={x.y + 12} width={24} height={24} viewBox="0 0 24 24"><path d={LINE[x.k]} /></svg>
          <text x={x.x + x.w / 2} y={x.y + 56} text-anchor="middle">{x.t}</text>
        </g>
      ))}
    </g>

    {groupNodes.map((g) => (
      <g class={`amap-group${g.soon ? ' soon' : ''}`}>
        <rect class="pill" x={g.pill.x} y={g.pill.y} width={g.pill.w} height={g.pill.h} rx={16} />
        <text class="pill-t" x={g.pill.x + g.pill.w / 2} y={g.cy + 5} text-anchor="middle">{g.proto}</text>
        {g.soon && <text class="soon-t" x={g.pill.x + g.pill.w / 2} y={g.cy + 32} text-anchor="middle">{t('coming soon', '即将推出')}</text>}
        <rect class="box" x={g.box.x} y={g.box.y} width={g.box.w} height={g.box.h} rx={16} />
        {g.logos.map((l) => (
          <g class="amap-logo biz">
            <title>{l.name}</title>
            <circle cx={l.cx} cy={l.cy} r={l.r} />
            {l.mark.brand && <svg x={l.cx - 11} y={l.cy - 11} width={22} height={22} viewBox="0 0 24 24"><path class="brand" d={BRAND[l.mark.brand]} /></svg>}
            {l.mark.line && <svg x={l.cx - 11} y={l.cy - 11} width={22} height={22} viewBox="0 0 24 24"><path class="line" d={LINE[l.mark.line]} /></svg>}
            <text class="cap" x={l.cx} y={l.cy + 40} text-anchor="middle">{l.name}</text>
          </g>
        ))}
      </g>
    ))}

    <g class="amap-people">
      <rect x={people.x} y={people.y} width={people.w} height={people.h} rx={18} />
      {['phone', 'laptop', 'globe'].map((k, i) => (
        <svg x={people.x + 46 + i * 46} y={people.y + 10} width={22} height={22} viewBox="0 0 24 24"><path d={LINE[k]} /></svg>
      ))}
      <text x={people.x + people.w / 2} y={people.y + 52} text-anchor="middle">{t('People chat with it, on every device', '用户在任意设备上和它聊天')}</text>
    </g>
  </svg>

  <div class="amap-stack" aria-hidden="true">
    <div><h4>{t('Your AI model', '你的 AI 模型')}</h4><ul class="logos">{models.map((m) => <li>{m.mark.brand ? <svg viewBox="0 0 24 24"><path class="brand" d={BRAND[m.mark.brand]} /></svg> : m.mark.line ? <svg viewBox="0 0 24 24"><path class="line" d={LINE[m.mark.line]} /></svg> : <b class="mono">{m.mark.text}</b>}<span>{m.name}</span></li>)}</ul></div>
    <div class="hubbox"><h4>AgentIM</h4><ul class="logos">{inner.map((x) => <li><svg viewBox="0 0 24 24"><path class="line" d={LINE[x.k]} /></svg><span>{x.t}</span></li>)}</ul></div>
    {groups.map((g) => <div><h4>{g.proto}{g.soon && ` · ${t('coming soon', '即将推出')}`}</h4><ul class="logos">{g.items.map((it) => <li>{it.mark.brand ? <svg viewBox="0 0 24 24"><path class="brand" d={BRAND[it.mark.brand]} /></svg> : <svg viewBox="0 0 24 24"><path class="line" d={LINE[it.mark.line!]} /></svg>}<span>{it.name}</span></li>)}</ul></div>)}
  </div>

  <figcaption id="amap-cap" class="sr-only">
    {t('Bring your own model (Claude, OpenAI, Gemini, DeepSeek, Qwen or any compatible API). Give the agent a role, Skills, knowledge and approval rules. Connect your business systems through OpenAPI, MCP, app sign-in (coming soon) or webhooks. People chat with it on every device.',
       '接入你自己的模型（Claude、OpenAI、Gemini、DeepSeek、通义千问或任意兼容 API），给 Agent 配上角色、Skills、知识库和审批规则，通过 OpenAPI、MCP、应用授权（即将推出）或 Webhook 连到企业系统。用户在任意设备上和它聊天。')}
  </figcaption>

  <ol class="amap-steps">
    {steps.map((s) => (
      <li>
        <span class="num">{s.n}</span>
        <div><h3>{s.t}</h3><p>{s.d}</p>{s.code && <code>{s.code}</code>}</div>
      </li>
    ))}
  </ol>
</figure>
