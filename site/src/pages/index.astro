---
// The homepage (docs/12 §5): what AgentIM is, one command to install, the
// features, the code, the platforms, how it compares, and the way to the
// docs and the dashboard. No analytics, no third-party scripts, no cookies;
// the font (Inter) is served from this site.
import '@fontsource-variable/inter';
import HeroChat from '../components/HeroChat';
import logoLight from '../assets/logo-light.svg?raw';
import logoDark from '../assets/logo-dark.svg?raw';

const GITHUB = 'https://github.com/wmkrfjnwvb-svg/agentim';
const install = [
  { id: 'sh', label: 'macOS / Linux', prompt: '$', code: 'curl -fsSL https://github.com/wmkrfjnwvb-svg/agentim/releases/latest/download/install.sh | sh' },
  { id: 'ps', label: 'Windows', prompt: 'PS>', code: 'irm https://github.com/wmkrfjnwvb-svg/agentim/releases/latest/download/install.ps1 | iex' },
  { id: 'docker', label: 'Docker', prompt: '$', code: 'docker run -p 8080:8080 -v agentim:/var/lib/agentim ghcr.io/wmkrfjnwvb-svg/agentim --db /var/lib/agentim/agentim.db' },
];
// Measured numbers from the README (server/bench), not targets.
const stats = [
  { value: '0', label: 'acknowledged messages lost after kill -9' },
  { value: '3 ms', label: 'median delivery, 10,000 connections' },
  { value: '20k', label: 'connections back in 2.3 s after a storm' },
  { value: '3', label: 'databases: SQLite, PostgreSQL, MySQL' },
];
const features = [
  { icon: 'stream', title: 'Streaming AI messages', text: 'Agents stream replies token by token, and anyone can press Stop. Every AI message is labelled as AI.', href: '/docs/concepts/streaming/' },
  { icon: 'check', title: 'Human approval', text: 'Agent drafts wait for a person. Agents ask people to decide before they act, and people can take over.', href: '/docs/concepts/approvals/' },
  { icon: 'shield', title: 'Guardrails', text: 'Loop breakers, rate and daily budgets, data-loss prevention and prompt-injection flags, on the server.', href: '/docs/concepts/guardrails/' },
  { icon: 'plug', title: 'MCP and agent SDKs', text: 'Any framework, any model. A built-in MCP server, and Node and Python SDKs with no dependencies.', href: '/docs/agent-sdks/' },
  { icon: 'layers', title: 'Ordered, never lost', text: 'A gap-free sequence per conversation, an offline queue on every device, and a cluster that fails over.', href: '/docs/concepts/sync-and-offline/' },
  { icon: 'scale', title: 'Compliance built in', text: 'GDPR export and deletion, EU AI Act labels, DSA reports and moderation, App Store chat rules.', href: '/docs/security/' },
];
const platforms = [
  { name: 'Web', mark: 'JS' }, { name: 'React', mark: 'Re' }, { name: 'React Native', mark: 'RN' }, { name: 'iOS', mark: 'Sw' },
  { name: 'Android', mark: 'Kt' }, { name: 'Flutter', mark: 'Dt' }, { name: 'Unity', mark: 'U' }, { name: '.NET', mark: 'C#' },
  { name: 'Node', mark: 'N' }, { name: 'Python', mark: 'Py' }, { name: 'Go', mark: 'Go' }, { name: 'MCP', mark: 'M' },
];
const compare = [
  { name: 'AgentIM', host: 'Your servers', source: 'Open source (Apache-2.0)', ai: 'Streaming, approvals, guardrails, MCP', price: 'Free; you pay for your servers' },
  { name: 'Stream Chat', host: 'Stream’s cloud', source: 'Closed', ai: 'Add-ons', price: 'By monthly active users and concurrent connections' },
  { name: 'Sendbird Chat', host: 'Sendbird’s cloud', source: 'Closed', ai: 'Add-ons', price: 'By monthly active users' },
  { name: 'Ably Chat', host: 'Ably’s cloud', source: 'Closed', ai: 'Build it yourself', price: 'By messages, connection- and channel-minutes' },
];
const icons: Record<string, string> = {
  stream: '<path d="M4 6h16M4 12h10M4 18h6"/><circle cx="18" cy="16" r="3"/>',
  check: '<path d="M9 12l2 2 4-4"/><rect x="3" y="3" width="18" height="18" rx="4"/>',
  shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
  plug: '<path d="M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0zM12 17v4"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/>',
  scale: '<path d="M12 3v18M5 7h14M5 7l-3 7a3 3 0 0 0 6 0zM19 7l-3 7a3 3 0 0 0 6 0z"/>',
};
const footer = [
  { title: 'Product', links: [['Quick start', '/docs/get-started/quickstart/'], ['Concepts', '/docs/concepts/overview/'], ['Dashboard', '/docs/operations/dashboard/'], ['Changelog', `${GITHUB}/blob/main/CHANGELOG.md`]] },
  { title: 'Developers', links: [['Client SDKs', '/docs/client-sdks/'], ['Agent SDKs', '/docs/agent-sdks/'], ['Open API', '/docs/reference/open-api/'], ['MCP tools', '/docs/reference/mcp-tools/']] },
  { title: 'Run it', links: [['Install', '/docs/operations/install/'], ['Cluster', '/docs/operations/cluster/'], ['Monitoring', '/docs/operations/monitoring/'], ['Go-live checklist', '/docs/guides/launch-checklist/']] },
  { title: 'Trust', links: [['Security', '/docs/security/'], ['Report a vulnerability', '/docs/security/reporting/'], ['GDPR', '/docs/security/gdpr/'], ['Site privacy', '/docs/security/site-privacy/']] },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AgentIM: open-source chat for people and AI agents</title>
    <meta name="description" content="A self-hosted chat server with SDKs and UI components for every platform. Streaming AI messages, human approval and guardrails are built in." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content="AgentIM: open-source chat for people and AI agents" />
    <meta property="og:description" content="Self-hosted chat infrastructure where AI agents are members, next to people." />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="top-inner">
        <a href="/" class="brand" aria-label="AgentIM home">
          <span class="logo-light" set:html={logoLight} />
          <span class="logo-dark" set:html={logoDark} />
        </a>
        <input type="checkbox" id="menu" class="menu-toggle" aria-label="Menu" />
        <label for="menu" class="menu-button" aria-hidden="true"><span></span><span></span><span></span></label>
        <nav aria-label="Main">
          <a href="/docs/">Docs</a>
          <a href="/docs/reference/">API</a>
          <a href="/docs/client-sdks/">SDKs</a>
          <a href="#dashboard">Dashboard</a>
          <a href={GITHUB} class="gh"><svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>GitHub</a>
          <a href="/docs/get-started/quickstart/" class="button primary small">Get started</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero-bg" aria-hidden="true"></div>
        <div class="wrap hero-grid">
          <div class="hero-text">
            <a class="pill" href="/docs/concepts/files/"><span class="pill-tag">New</span> Files and images, straight to S3 <span aria-hidden="true">→</span></a>
            <h1>Chat for people <span class="grad">and AI agents</span></h1>
            <p class="lead">The open-source, self-hosted chat backend where AI agents are members, next to people. SDKs and UI components for every platform, with streaming, human approval and guardrails built in.</p>
            <div class="actions">
              <a href="/docs/get-started/quickstart/" class="button primary large">Start building <span aria-hidden="true">→</span></a>
              <a href={GITHUB} class="button large">View on GitHub</a>
            </div>
            <p class="small-print">Apache-2.0 · Every feature free · Runs on one machine or a cluster</p>
          </div>
          <div class="hero-visual">
            <div class="hero-chat" aria-label="A sample chat between a customer and an AI agent">
              <HeroChat client:visible />
            </div>
            <div class="float-card" aria-hidden="true">
              <span class="dot"></span>
              <div><strong>Delivered in order</strong><small>seq 42 · committed</small></div>
            </div>
          </div>
        </div>
        <ul class="wrap stats" aria-label="Measured with server/bench">
          {stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
        </ul>
      </section>

      <section class="install" aria-labelledby="install-title">
        <div class="wrap narrow">
          <p class="eyebrow">Install</p>
          <h2 id="install-title">One command. No dependencies.</h2>
          <p class="lead center">A single static binary with SQLite inside. Point it at PostgreSQL or MySQL when you grow.</p>
          <div class="terminal">
            <div class="term-bar">
              <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
              <div class="tabs" role="tablist" aria-label="Platform">
                {install.map((t, i) => <button role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>)}
              </div>
            </div>
            {install.map((t, i) => (
              <div class="code" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
                <pre><code><span class="prompt" aria-hidden="true">{t.prompt} </span>{t.code}</code></pre>
                <button class="copy" data-copy={t.code} aria-label={`Copy the ${t.label} command`}>Copy</button>
              </div>
            ))}
          </div>
          <p class="note center">Then open the link the server prints to set up your dashboard. <a href="/docs/get-started/quickstart/">Read the quick start →</a></p>
        </div>
      </section>

      <section class="features" aria-labelledby="features-title">
        <div class="wrap">
          <p class="eyebrow">Built for AI products</p>
          <h2 id="features-title">Everything your agents need from chat</h2>
          <p class="lead">Not a chat SDK with a bot bolted on. Agents are first-class members, and people stay in control.</p>
          <ul>
            {features.map((f) => (
              <li>
                <span class="icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[f.icon]} /></span>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
                <a href={f.href}>Learn more <span aria-hidden="true">→</span><span class="sr"> about {f.title.toLowerCase()}</span></a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="code-compare" aria-labelledby="code-title">
        <div class="wrap">
          <p class="eyebrow on-dark">Developer experience</p>
          <h2 id="code-title">A few lines on each side</h2>
          <p class="lead on-dark">Your backend signs a token. Your app renders the chat. Your agent streams its answer. That’s the whole integration.</p>
          <div class="pair">
            <figure class="window">
              <div class="term-bar"><span class="lights" aria-hidden="true"><i></i><i></i><i></i></span><figcaption>app.tsx</figcaption></div>
              <pre><code>{`// backend: signing needs no call to AgentIM
const token = createUserToken(signingKey, user.id);

// app
const client = await AgentIMClient.create({
  url: 'https://chat.example.com',
  deviceId,
  tokenProvider: () => fetch('/token').then((r) => r.text()),
});
client.connect();

<AgentIM client={client}>
  <Chat convId={convId} />
</AgentIM>`}</code></pre>
            </figure>
            <figure class="window">
              <div class="term-bar">
                <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
                <figcaption class="sr">Your agent</figcaption>
                <div class="tabs" role="tablist" aria-label="Language">
                  <button role="tab" id="tab-node" aria-controls="panel-node" aria-selected="true">agent.js</button>
                  <button role="tab" id="tab-py" aria-controls="panel-py" aria-selected="false" tabindex="-1">agent.py</button>
                </div>
              </div>
              <pre role="tabpanel" id="panel-node" aria-labelledby="tab-node"><code>{`import { Agent } from '@agentimhq/agent';

const agent = new Agent({ url, key: process.env.AGENTIM_KEY });

agent.onMessage(async (msg, ctx) => {
  const s = await ctx.stream();
  for await (const token of llm(msg.content)) {
    await s.append(token);
  }
  await s.end();
});

await agent.start();`}</code></pre>
              <pre role="tabpanel" id="panel-py" aria-labelledby="tab-py" hidden><code>{`import asyncio, os
from agentim_agent import Agent

agent = Agent(url, os.environ["AGENTIM_KEY"])

@agent.on_message
async def answer(msg, ctx):
    s = await ctx.stream()
    async for token in llm(msg["content"]):
        await s.append(token)
    await s.end()

asyncio.run(agent.run())`}</code></pre>
            </figure>
          </div>
        </div>
      </section>

      <section class="platforms" aria-labelledby="platforms-title">
        <div class="wrap">
          <p class="eyebrow">SDKs</p>
          <h2 id="platforms-title">One core, every platform</h2>
          <p class="lead">One Rust core holds the sync, retry and offline rules, so your app behaves the same everywhere. Each platform gets a native, idiomatic wrapper.</p>
          <ul>{platforms.map((p) => <li><span class="mark" aria-hidden="true">{p.mark}</span>{p.name}</li>)}</ul>
          <a class="more" href="/docs/client-sdks/">Browse the SDKs →</a>
        </div>
      </section>

      <section class="dashboard" id="dashboard" aria-labelledby="dashboard-title">
        <div class="wrap dash-grid">
          <div>
            <p class="eyebrow">Dashboard</p>
            <h2 id="dashboard-title">The dashboard comes with your server</h2>
            <p class="lead">Open <code>/console</code> on your server. Developers manage keys, people, agents, conversations, reports and permissions. Operators watch databases and the cluster. Nothing extra to install or host.</p>
            <ul class="checks">
              <li>Stop or take over any agent in one click</li>
              <li>Reading a conversation asks for a reason, and is audited</li>
              <li>Roles for owners, developers, moderators and operators</li>
            </ul>
            <a href="/docs/operations/dashboard/" class="button primary">Open your dashboard <span aria-hidden="true">→</span></a>
          </div>
          <div class="console" aria-hidden="true">
            <div class="term-bar light"><span class="lights"><i></i><i></i><i></i></span><span class="url">chat.example.com/console</span></div>
            <div class="console-body">
              <aside>
                <b>App</b><span class="on">Overview</span><span>Keys</span><span>People</span><span>Conversations</span><span>Agents</span><span>Reports</span>
                <b>Deployment</b><span>Status</span><span>Cluster</span>
              </aside>
              <div class="console-main">
                <div class="console-title">Overview</div>
                <div class="tiles">
                  <div><small>People</small><strong>12,480</strong></div>
                  <div><small>Agents</small><strong>36</strong></div>
                  <div><small>Online now</small><strong>1,204</strong></div>
                  <div><small>Open reports</small><strong class="warn">3</strong></div>
                </div>
                <div class="rows">
                  <div><span class="badge ai">AI</span>Support Nova<em class="ok">Running</em></div>
                  <div><span class="badge ai">AI</span>Refund Bot<em class="hold">Taken over</em></div>
                  <div><span class="badge ai">AI</span>Release Notes<em class="stop">Stopped</em></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="compare" aria-labelledby="compare-title">
        <div class="wrap">
          <p class="eyebrow">Compare</p>
          <h2 id="compare-title">Own your chat, and your costs</h2>
          <div class="table">
            <table>
              <thead><tr><th scope="col"><span class="sr">Product</span></th><th scope="col">Runs on</th><th scope="col">Source</th><th scope="col">AI features</th><th scope="col">Pricing</th></tr></thead>
              <tbody>{compare.map((c) => <tr><th scope="row">{c.name}</th><td>{c.host}</td><td>{c.source}</td><td>{c.ai}</td><td>{c.price}</td></tr>)}</tbody>
            </table>
          </div>
          <p class="note">From the vendors’ pricing pages on October 29, 2026: <a href="https://getstream.io/chat/pricing/">Stream</a>, <a href="https://sendbird.com/pricing/chat">Sendbird</a>, <a href="https://ably.com/pricing">Ably</a>.</p>
        </div>
      </section>

      <section class="cta" aria-labelledby="cta-title">
        <div class="wrap cta-inner">
          <h2 id="cta-title">Ship chat with AI agents this week</h2>
          <p>Five minutes from install to an agent streaming its first reply.</p>
          <div class="actions center">
            <a href="/docs/get-started/quickstart/" class="button white large">Start building <span aria-hidden="true">→</span></a>
            <a href="/docs/" class="button ghost large">Read the docs</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap foot-grid">
        <div class="foot-brand">
          <span class="logo-light" set:html={logoLight} />
          <span class="logo-dark" set:html={logoDark} />
          <p>Open-source chat for people and AI agents.</p>
          <p class="tiny">This site uses no cookies, analytics or third-party scripts.</p>
        </div>
        {footer.map((col) => (
          <nav aria-label={col.title}>
            <h3>{col.title}</h3>
            {col.links.map(([label, href]) => <a href={href}>{label}</a>)}
          </nav>
        ))}
      </div>
      <div class="wrap foot-bottom">
        <span>© 2026 AgentIM contributors · <a href={`${GITHUB}/blob/main/LICENSE`}>Apache-2.0</a></span>
        <a href={GITHUB}>GitHub</a>
      </div>
    </footer>

    <script>
      // Tabs (arrow keys move between them) and copy buttons.
      for (const list of document.querySelectorAll<HTMLElement>('[role=tablist]')) {
        const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role=tab]')];
        const pick = (t: HTMLButtonElement) => {
          for (const x of tabs) {
            const on = x === t;
            x.setAttribute('aria-selected', String(on));
            x.tabIndex = on ? 0 : -1;
            document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
          }
          t.focus();
        };
        for (const t of tabs) {
          t.addEventListener('click', () => pick(t));
          t.addEventListener('keydown', (e) => {
            const i = tabs.indexOf(t);
            if (e.key === 'ArrowRight') pick(tabs[(i + 1) % tabs.length]);
            if (e.key === 'ArrowLeft') pick(tabs[(i + tabs.length - 1) % tabs.length]);
          });
        }
      }
      for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        b.addEventListener('click', async () => {
          await navigator.clipboard?.writeText(b.dataset.copy!).catch(() => {});
          b.textContent = 'Copied';
          setTimeout(() => (b.textContent = 'Copy'), 1500);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff; --fg: #0b1220; --muted: #4b5567; --line: #e6e8ee; --soft: #f6f7fb; --card: #ffffff;
    --accent: #2563eb; --accent-2: #7c3aed; --accent-text: #1d4ed8; --tint: #eef3ff;
    --code: #0b1020; --code-fg: #dbe2f0; --code-dim: #7d89a6;
    --shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 12px 32px -12px rgba(16, 24, 40, 0.16);
    --font: 'Inter Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #07090f; --fg: #f3f5fa; --muted: #a2abbd; --line: #1d2333; --soft: #0c1018; --card: #0f1420;
      --accent: #3b82f6; --accent-2: #a78bfa; --accent-text: #7fb0ff; --tint: #121a2e;
      --code: #0a0e18; --code-fg: #dbe2f0;
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 16px 40px -16px rgba(0, 0, 0, 0.7);
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.6 var(--font); font-feature-settings: 'cv11', 'ss01'; -webkit-font-smoothing: antialiased; }
  a { color: var(--accent-text); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 6px; }
  .skip { position: absolute; left: -999px; top: 8px; background: var(--bg); padding: 8px 12px; z-index: 10; }
  .skip:focus { left: 8px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .wrap { width: min(1200px, 100% - 32px); margin-inline: auto; }
  .wrap.narrow { width: min(860px, 100% - 32px); text-align: center; }

  /* Header */
  .top { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 80%, transparent); backdrop-filter: saturate(180%) blur(12px); border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent); }
  .top-inner { width: min(1200px, 100% - 32px); margin-inline: auto; display: flex; align-items: center; gap: 16px; height: 64px; position: relative; }
  .brand { display: inline-flex; height: 30px; }
  .brand svg, .foot-brand svg { height: 30px; width: auto; }
  .logo-dark { display: none; }
  @media (prefers-color-scheme: dark) { .logo-light { display: none; } .logo-dark { display: inline-flex; } }
  .top nav { margin-inline-start: auto; display: flex; align-items: center; gap: 28px; }
  .top nav a { color: var(--muted); text-decoration: none; font-weight: 500; font-size: 15px; transition: color 0.15s; }
  .top nav a:hover { color: var(--fg); }
  .top nav .gh { display: inline-flex; align-items: center; gap: 6px; }
  .menu-toggle, .menu-button { display: none; }

  /* Buttons */
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 0 20px; border-radius: 10px; border: 1px solid var(--line); color: var(--fg) !important; text-decoration: none; font-weight: 600; font-size: 15px; background: var(--card); box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05); transition: transform 0.15s, box-shadow 0.15s, background 0.15s, border-color 0.15s; }
