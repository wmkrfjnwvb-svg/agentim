---
// The homepage (docs/12 §5): what AgentIM is, one command to install, the
// features, the code, the platforms, how it compares, and the way to the
// docs and the dashboard. No analytics, no third-party scripts, no cookies.
import HeroChat from '../components/HeroChat';
import logoLight from '../assets/logo-light.svg?raw';
import logoDark from '../assets/logo-dark.svg?raw';

const GITHUB = 'https://github.com/wmkrfjnwvb-svg/agentim';
const install = [
  { id: 'sh', label: 'macOS / Linux', code: 'curl -fsSL https://github.com/wmkrfjnwvb-svg/agentim/releases/latest/download/install.sh | sh' },
  { id: 'ps', label: 'Windows', code: 'irm https://github.com/wmkrfjnwvb-svg/agentim/releases/latest/download/install.ps1 | iex' },
  { id: 'docker', label: 'Docker', code: 'docker run -p 8080:8080 -v agentim:/var/lib/agentim ghcr.io/wmkrfjnwvb-svg/agentim --db /var/lib/agentim/agentim.db' },
];
const features = [
  { icon: 'stream', title: 'Streaming AI messages', text: 'Agents stream their replies token by token; people can stop them. Every AI message is marked as AI.', href: '/docs/concepts/streaming/' },
  { icon: 'check', title: 'Human approval', text: 'Agent drafts wait for a person to approve; agents can ask people to decide before they act.', href: '/docs/concepts/approvals/' },
  { icon: 'shield', title: 'Guardrails', text: 'Loop breakers, rate and daily budgets, content filters and prompt-injection marks, per conversation.', href: '/docs/concepts/guardrails/' },
  { icon: 'plug', title: 'MCP and agent SDKs', text: 'Connect any agent: an MCP server built in, and small SDKs for Node and Python.', href: '/docs/agent-sdks/' },
  { icon: 'layers', title: 'Ordered, never lost, clustered', text: 'One sequence per conversation, at-least-once delivery with dedup, offline sync, and a cluster that fails over.', href: '/docs/concepts/sync/' },
  { icon: 'scale', title: 'Compliance built in', text: 'GDPR export and deletion, the EU AI Act AI mark, DSA reports and moderation, App Store UGC rules.', href: '/docs/security/' },
];
const platforms = ['Web', 'React', 'React Native', 'iOS', 'Android', 'Flutter', 'Unity', '.NET', 'Node', 'Python', 'Go'];
const compare = [
  { name: 'AgentIM', host: 'Your servers', source: 'Open source (Apache-2.0)', ai: 'Streaming, approvals, guardrails, MCP', price: 'Free; you pay for your servers' },
  { name: 'Stream Chat', host: 'Stream’s cloud', source: 'Closed', ai: 'Add-ons', price: 'By monthly active users and concurrent connections' },
  { name: 'Sendbird Chat', host: 'Sendbird’s cloud', source: 'Closed', ai: 'Add-ons', price: 'By monthly active users' },
  { name: 'Ably Chat', host: 'Ably’s cloud', source: 'Closed', ai: 'Build it yourself', price: 'By messages, connection- and channel-minutes' },
];
const icons: Record<string, string> = {
  stream: '<path d="M4 6h16M4 12h10M4 18h6"/><circle cx="18" cy="16" r="3"/>',
  check: '<path d="M9 12l2 2 4-4"/><rect x="3" y="3" width="18" height="18" rx="4"/>',
  shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>',
  plug: '<path d="M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0zM12 17v4"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/>',
  scale: '<path d="M12 3v18M5 7h14M5 7l-3 7a3 3 0 0 0 6 0zM19 7l-3 7a3 3 0 0 0 6 0z"/>',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AgentIM: open-source chat for people and AI agents</title>
    <meta name="description" content="A self-hosted IM server with SDKs and UI components for every platform. AI messages, approvals and guardrails are built in." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a href="/" class="brand" aria-label="AgentIM home">
        <span class="logo-light" set:html={logoLight} />
        <span class="logo-dark" set:html={logoDark} />
      </a>
      <input type="checkbox" id="menu" class="menu-toggle" aria-label="Menu" />
      <label for="menu" class="menu-button" aria-hidden="true"><span></span><span></span><span></span></label>
      <nav aria-label="Main">
        <a href="/docs/get-started/quickstart/">Docs</a>
        <a href="/docs/reference/open-api/">API</a>
        <a href="/docs/client-sdks/">SDKs</a>
        <a href="#dashboard">Dashboard</a>
        <a href={GITHUB} class="gh">GitHub</a>
        <a href="/docs/get-started/quickstart/" class="button primary small">Get started</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero-text">
          <p class="eyebrow">Open source · Self-hosted · AI native</p>
          <h1>Open-source chat for people and AI agents</h1>
          <p class="lead">A self-hosted IM server with SDKs and UI components for every platform. Streaming AI messages, human approval and guardrails are built in, not bolted on.</p>
          <div class="actions">
            <a href="/docs/get-started/quickstart/" class="button primary">Get started</a>
            <a href={GITHUB} class="button">View on GitHub</a>
          </div>
        </div>
        <div class="hero-chat" aria-label="A sample chat between a customer and an AI agent">
          <HeroChat client:visible />
        </div>
      </section>

      <section class="install" aria-labelledby="install-title">
        <h2 id="install-title">One command to install</h2>
        <div class="tabs" role="tablist">
          {install.map((t, i) => <button role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>)}
        </div>
        {install.map((t, i) => (
          <div class="code" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
            <pre><code>{t.code}</code></pre>
            <button class="copy" data-copy={t.code}>Copy</button>
          </div>
        ))}
        <p class="note">Then open the link the server prints to set up the dashboard. <a href="/docs/get-started/quickstart/">Quickstart →</a></p>
      </section>

      <section class="features" aria-labelledby="features-title">
        <h2 id="features-title">Everything an AI product needs from chat</h2>
        <ul>
          {features.map((f) => (
            <li>
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[f.icon]} />
              <h3>{f.title}</h3>
              <p>{f.text}</p>
              <a href={f.href}>Learn more <span aria-hidden="true">→</span><span class="sr"> about {f.title.toLowerCase()}</span></a>
            </li>
          ))}
        </ul>
      </section>

      <section class="code-compare" aria-labelledby="code-title">
        <h2 id="code-title">A few lines on each side</h2>
        <div class="pair">
          <figure>
            <figcaption>Your app: sign a token, render the chat</figcaption>
            <pre><code>{`// backend: no call to AgentIM
import { createUserToken } from '@agentimhq/server';
const token = createUserToken(signingKey, user.id);

// frontend
import { AgentIMClient } from '@agentimhq/client-web';
import { AgentIM, Chat } from '@agentimhq/react';

const client = await AgentIMClient.create({
  url: 'https://chat.example.com',
  deviceId,
  tokenProvider: () => fetch('/token').then((r) => r.text()),
});
client.connect();

<AgentIM client={client} me={user.id}>
  <Chat convId={convId} />
</AgentIM>`}</code></pre>
          </figure>
          <figure>
            <figcaption>Your agent: ten lines</figcaption>
            <div class="tabs small" role="tablist">
              <button role="tab" id="tab-node" aria-controls="panel-node" aria-selected="true">Node</button>
              <button role="tab" id="tab-py" aria-controls="panel-py" aria-selected="false" tabindex="-1">Python</button>
            </div>
            <pre role="tabpanel" id="panel-node" aria-labelledby="tab-node"><code>{`import { Agent } from '@agentimhq/agent';

const agent = new Agent({ url: 'https://chat.example.com', key: process.env.AGENTIM_KEY });

agent.onMessage(async (msg, ctx) => {
  const s = await ctx.stream();
  for await (const token of llm(msg.content)) await s.append(token);
  await s.end();
});

await agent.start();`}</code></pre>
            <pre role="tabpanel" id="panel-py" aria-labelledby="tab-py" hidden><code>{`import asyncio, os
from agentim_agent import Agent

agent = Agent("https://chat.example.com", os.environ["AGENTIM_KEY"])

@agent.on_message
async def answer(msg, ctx):
    s = await ctx.stream()
    async for token in llm(msg["content"]):
        await s.append(token)
    await s.end()

asyncio.run(agent.run())`}</code></pre>
          </figure>
        </div>
      </section>

      <section class="platforms" aria-labelledby="platforms-title">
        <h2 id="platforms-title">One core, every platform</h2>
        <p class="lead small">One Rust core with the sync, retry and offline rules, wrapped for each platform; UI components for React and React Native.</p>
        <ul>{platforms.map((p) => <li>{p}</li>)}</ul>
      </section>

      <section class="compare" aria-labelledby="compare-title">
        <h2 id="compare-title">How it compares</h2>
        <div class="table">
          <table>
            <thead><tr><th scope="col"></th><th scope="col">Runs on</th><th scope="col">Source</th><th scope="col">AI features</th><th scope="col">Pricing</th></tr></thead>
            <tbody>{compare.map((c) => <tr><th scope="row">{c.name}</th><td>{c.host}</td><td>{c.source}</td><td>{c.ai}</td><td>{c.price}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="note">From the vendors’ pricing pages on October 29, 2026: <a href="https://getstream.io/chat/pricing/">Stream</a>, <a href="https://sendbird.com/pricing/chat">Sendbird</a>, <a href="https://ably.com/pricing">Ably</a>.</p>
      </section>

      <section class="dashboard" id="dashboard" aria-labelledby="dashboard-title">
        <h2 id="dashboard-title">The dashboard comes with your server</h2>
        <p class="lead small">Every AgentIM server has its dashboard at <code>/console</code>: keys, people, agents, conversations, reports and permissions for developers; databases and the cluster for operators. On first start the server prints a one-time link to create the first owner.</p>
        <a href="/docs/operations/dashboard/" class="button">Open your dashboard</a>
      </section>
    </main>

    <footer>
      <nav aria-label="Footer">
        <a href="/docs/get-started/quickstart/">Docs</a>
        <a href={GITHUB}>GitHub</a>
        <a href={`${GITHUB}/blob/main/CHANGELOG.md`}>Changelog</a>
        <a href="/docs/security/reporting/">Security</a>
        <a href={`${GITHUB}/blob/main/LICENSE`}>License (Apache-2.0)</a>
        <a href="/docs/security/site-privacy/">Privacy</a>
      </nav>
      <p>This site uses no cookies, analytics or third-party scripts.</p>
    </footer>

    <script>
      // Tabs (arrow keys move between them) and copy buttons.
      for (const list of document.querySelectorAll<HTMLElement>('[role=tablist]')) {
        const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role=tab]')];
        const pick = (t: HTMLButtonElement) => {
          for (const x of tabs) {
            const on = x === t;
            x.setAttribute('aria-selected', String(on));
            x.tabIndex = on ? 0 : -1;
            document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
          }
          t.focus();
        };
        for (const t of tabs) {
          t.addEventListener('click', () => pick(t));
          t.addEventListener('keydown', (e) => {
            const i = tabs.indexOf(t);
            if (e.key === 'ArrowRight') pick(tabs[(i + 1) % tabs.length]);
            if (e.key === 'ArrowLeft') pick(tabs[(i + tabs.length - 1) % tabs.length]);
          });
        }
      }
      for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        b.addEventListener('click', async () => {
          await navigator.clipboard?.writeText(b.dataset.copy!).catch(() => {});
          b.textContent = 'Copied';
          setTimeout(() => (b.textContent = 'Copy'), 1500);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff; --fg: #0f172a; --muted: #475569; --line: #e2e8f0; --soft: #f8fafc; --accent: #2563eb; --accent-text: #1d4ed8; --code: #0f172a; --code-fg: #e2e8f0;
    --font: -apple-system, BlinkMacSystemFont, 'Segoe UI Variable', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #09090b; --fg: #f8fafc; --muted: #a1a1aa; --line: #27272a; --soft: #111114; --accent: #2563eb; --accent-text: #60a5fa; --code: #18181b; --code-fg: #e4e4e7; color-scheme: dark; }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.6 var(--font); }
  a { color: var(--accent-text); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .skip { position: absolute; left: -999px; top: 8px; background: var(--bg); padding: 8px 12px; z-index: 10; }
  .skip:focus { left: 8px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .top { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 16px; padding: 12px max(16px, calc((100vw - 1200px) / 2)); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .brand { display: inline-flex; height: 32px; }
  .brand svg { height: 32px; width: auto; }
  .logo-dark { display: none; }
  @media (prefers-color-scheme: dark) { .logo-light { display: none; } .logo-dark { display: inline-flex; } }
  .top nav { margin-inline-start: auto; display: flex; align-items: center; gap: 24px; }
  .top nav a { color: var(--fg); text-decoration: none; font-weight: 500; }
  .top nav a:hover { color: var(--accent-text); }
  .menu-toggle, .menu-button { display: none; }

  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 20px; border-radius: 10px; border: 1px solid var(--line); color: var(--fg) !important; text-decoration: none; font-weight: 600; background: var(--bg); }
  .button:hover { border-color: var(--muted); }
  .button.primary { background: var(--accent); border-color: var(--accent); color: #fff !important; }
  .button.primary:hover { background: #1d4ed8; }
  .button.small { min-height: 36px; padding: 0 14px; }

  main > section { padding: 72px max(16px, calc((100vw - 1200px) / 2)); }
  h1 { font-size: clamp(36px, 5vw, 60px); line-height: 1.05; letter-spacing: -0.03em; margin: 0 0 20px; }
  h2 { font-size: clamp(26px, 3vw, 36px); letter-spacing: -0.02em; margin: 0 0 24px; }
  h3 { font-size: 18px; margin: 12px 0 6px; }
  .eyebrow { color: var(--accent-text); font-weight: 600; font-size: 14px; letter-spacing: 0.02em; margin: 0 0 12px; }
  .lead { font-size: 19px; color: var(--muted); max-width: 640px; margin: 0 0 28px; }
  .lead.small { font-size: 17px; }
  .note { color: var(--muted); font-size: 14px; margin-top: 16px; }

  .hero { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; padding-top: 64px !important; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-chat { height: 560px; border: 1px solid var(--line); border-radius: 20px; overflow: hidden; box-shadow: 0 24px 60px -20px rgba(15, 23, 42, 0.25); background: var(--bg); }
  .hero-chat > astro-island, .hero-chat .aim-chat { height: 100%; display: flex; flex-direction: column; }

  .install, .code-compare, .compare { background: var(--soft); border-block: 1px solid var(--line); }
  .tabs { display: flex; gap: 4px; margin-bottom: -1px; flex-wrap: wrap; }
  .tabs button { font: inherit; font-size: 14px; font-weight: 600; padding: 8px 14px; border: 1px solid transparent; border-bottom: 0; border-radius: 10px 10px 0 0; background: transparent; color: var(--muted); cursor: pointer; min-height: 40px; }
  .tabs button[aria-selected='true'] { background: var(--code); color: var(--code-fg); }
  .code { position: relative; }
  pre { margin: 0; background: var(--code); color: var(--code-fg); padding: 20px; border-radius: 0 12px 12px 12px; overflow-x: auto; font: 14px/1.6 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .install pre { padding-inline-end: 96px; }
  .copy { position: absolute; top: 12px; right: 12px; font: inherit; font-size: 13px; padding: 6px 12px; border-radius: 8px; border: 1px solid #3f3f46; background: #27272a; color: #fff; cursor: pointer; min-height: 32px; }

  .features ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .features li { padding: 24px; border: 1px solid var(--line); border-radius: 16px; }
  .features svg { color: var(--accent-text); }
  .features p { color: var(--muted); margin: 0 0 12px; }
  .features a { font-weight: 600; text-decoration: none; }

  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  figure { margin: 0; min-width: 0; }
  figcaption { font-weight: 600; margin-bottom: 10px; }
  .pair > figure:first-child pre { border-radius: 12px; }

  .platforms ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .platforms li { padding: 10px 18px; border: 1px solid var(--line); border-radius: 999px; font-weight: 600; }

  .table { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); }
  table { border-collapse: collapse; width: 100%; min-width: 720px; font-size: 15px; }
  th, td { text-align: start; padding: 14px 16px; border-bottom: 1px solid var(--line); vertical-align: top; }
  thead th { font-size: 13px; color: var(--muted); font-weight: 600; }
  tbody tr:first-child th, tbody tr:first-child td { background: color-mix(in srgb, var(--accent) 8%, transparent); }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }

  .dashboard { text-align: center; }
  .dashboard .lead { margin-inline: auto; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.92em; }

  footer { padding: 40px max(16px, calc((100vw - 1200px) / 2)); border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; }
  footer nav { display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 12px; }
  footer a { color: var(--fg); text-decoration: none; }

  /* Tablet */
  @media (max-width: 1024px) {
    .hero { grid-template-columns: 1fr; gap: 40px; }
    .hero-chat { height: 520px; max-width: 640px; width: 100%; }
    .features ul { grid-template-columns: repeat(2, 1fr); }
    .pair { grid-template-columns: 1fr; }
  }
  /* Phone and tablet: the menu folds into a button */
  @media (max-width: 860px) {
    .menu-button { display: inline-flex; flex-direction: column; justify-content: center; gap: 5px; margin-inline-start: auto; width: 44px; height: 44px; padding: 10px; cursor: pointer; border-radius: 10px; }
    .menu-button span { display: block; height: 2px; background: var(--fg); border-radius: 2px; }
    .menu-toggle { display: block; position: absolute; opacity: 0; width: 44px; height: 44px; right: 16px; margin: 0; cursor: pointer; }
    .menu-toggle:focus-visible + .menu-button { outline: 2px solid var(--accent); }
    .top nav { display: none; position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 0; padding: 8px 16px 16px; background: var(--bg); border-bottom: 1px solid var(--line); }
    .top nav a { padding: 12px 4px; min-height: 44px; }
    .top nav .button { margin-top: 8px; }
    .menu-toggle:checked ~ nav { display: flex; }
  }
  @media (max-width: 600px) {
    main > section { padding-block: 48px; }
    .features ul { grid-template-columns: 1fr; }
    .hero-chat { height: 480px; border-radius: 16px; }
    .lead { font-size: 17px; }
  }
  @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; } }
</style>
